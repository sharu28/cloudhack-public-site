# Resend transactional email — https://resend.com/api-keys
RESEND_API_KEY=
# Sender. MUST be an address on a Resend-verified domain.
# Use onboarding@resend.dev for local testing before convoy-tech.com is verified.
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Where team signup / contact-form enquiries are delivered
CONTACT_TO_EMAIL=info@convoy-tech.com
# Optional: route /connect meetup leads to a different follow-up inbox.
# Falls back to CONTACT_TO_EMAIL when omitted.
MEETUP_TO_EMAIL=
